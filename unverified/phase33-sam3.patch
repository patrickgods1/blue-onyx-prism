+def nonfinite_output(phrases: list, flags: list):
+    """The first `(phrase, output name)` whose output is not all finite, None when every one is:
+    `flags[i][k]` says whether output `SAM3_OUTPUTS[k]` of `phrases[i]` is (`Sam3.check`). Phrase
+    order, then output order, as a check after each phrase would find it."""
+    for phrase, row in zip(phrases, flags):
+        for name, ok in zip(SAM3_OUTPUTS, row):
+            if not ok:
+                return phrase, name
+    return None
+
