<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Installed by scripts/install_launchd.sh. The program dir (/usr/local/blue-onyx-prism) is owned
  by root; the daemon runs as the _blueonyx role account and writes only to its data root
  /usr/local/var/blue-onyx-prism (config, models, cache, downloads) and /var/log/blue-onyx-prism.
  The config's log_path sends the log to daily files there (14 kept); stdout/stderr only carry
  what is printed before logging starts (and panics), rotated by /etc/newsyslog.d/blue-onyx-prism.conf.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blueonyx.prism</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/blue-onyx-prism/blue-onyx-prism</string>
        <string>--config</string>
        <string>/usr/local/var/blue-onyx-prism/blue_onyx_prism_config.json</string>
    </array>
    <key>UserName</key>
    <string>_blueonyx</string>
    <key>GroupName</key>
    <string>_blueonyx</string>
    <key>WorkingDirectory</key>
    <string>/usr/local/var/blue-onyx-prism</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Files the daemon creates are not world-readable (umask 027, written in decimal: the
         config, logs and saved images are 0640 / 0750). -->
    <key>Umask</key>
    <integer>23</integer>
    <!-- Seconds launchd waits after SIGTERM before SIGKILL: time for the graceful drain of
         in-flight detections (the same 30 s as the Docker stop_grace_period). -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <!-- At most one restart every 10 s after a crash (the launchd default, stated explicitly). -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- Standard (launchd's default, stated so it is not changed by accident): Background
         would throttle CPU and I/O, which detections are sensitive to; Interactive would raise
         the priority above what a daemon needs. -->
    <key>ProcessType</key>
    <string>Standard</string>
    <!-- Open-file soft limit (sockets, model, cache and log files): the macOS default of 256
         is tight for many concurrent Blue Iris connections; 4096 is still a bound. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/blue-onyx-prism/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/blue-onyx-prism/stdout.log</string>
</dict>
</plist>
