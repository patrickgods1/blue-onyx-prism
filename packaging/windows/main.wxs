<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-machine MSI for Blue Onyx Prism (WiX Toolset v7, v4+ schema).
  Build with build-msi.ps1; preprocessor variables: Version, BinDir, RepoRoot, LicenseRtf,
  VcRuntimeDir.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Blue Onyx Prism"
           Manufacturer="Blue Onyx Prism"
           Version="$(var.Version)"
           UpgradeCode="6B1D7C52-3E0A-4F5B-9C6E-8A2F41D0B7E3"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Blue Onyx Prism is already installed. Uninstall it first if you really want to install an older version." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.RepoRoot)\assets\favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Public properties (msiexec /i blue-onyx-prism.msi PORT=32169). An uninstall keeps
         C:\ProgramData\BlueOnyxPrism; REMOVEDATA=1 on uninstall (msiexec /x blue-onyx-prism.msi
         REMOVEDATA=1) deletes it. KEEPDATA=1 asked for the keeping before it became the default:
         it is still accepted, for old scripts, and wins over REMOVEDATA=1. -->
    <Property Id="PORT" Value="32168" Secure="yes" />
    <Property Id="REMOVEDATA" Secure="yes" />
    <Property Id="KEEPDATA" Secure="yes" />
    <!-- Firewall profiles, NET_FW_PROFILE2 bits: domain (1) + private (2). The Profile attribute
         names one profile or "all", so the mask comes through a property: the extension's custom
         action reads it as a formatted integer and hands it to INetFwRule::put_Profiles. -->
    <Property Id="BOP_FIREWALL_PROFILES" Value="3" />

    <!-- Block when the service was installed by scripts\install_service.ps1 (no MSI marker value),
         but never block an upgrade/repair/uninstall of this MSI. -->
    <Property Id="EXISTING_SERVICE_IMAGEPATH">
      <RegistrySearch Id="ExistingServiceSearch" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\BlueOnyxPrismService" Name="ImagePath" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="MSI_INSTALL_MARKER">
      <RegistrySearch Id="InstallMarkerSearch" Root="HKLM" Key="SOFTWARE\BlueOnyxPrism" Name="Installer" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR WIX_UPGRADE_DETECTED OR (NOT EXISTING_SERVICE_IMAGEPATH) OR MSI_INSTALL_MARKER"
            Message="Blue Onyx Prism is already installed as a service by scripts\install_service.ps1. Run scripts\uninstall_service.ps1 as administrator first, then run this installer again." />

    <!-- UI -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Directories -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Blue Onyx Prism" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="BlueOnyxPrism" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Blue Onyx Prism" />
    </StandardDirectory>

    <!-- Close a running tray before its exe is replaced or removed (upgrade, uninstall, repair):
         the tray has no window to ask, so it is terminated. -->
    <util:CloseApplication Id="CloseTray" Target="blue-onyx-prism-tray.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />

    <!-- Failure actions: restart after 5 s, 30 s, 120 s; reset the count after an hour. Same as
         install_service.ps1 (the built-in ServiceConfig has a single restart delay only). -->
    <CustomAction Id="SetServiceFailureActions"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]sc.exe&quot; failure BlueOnyxPrismService reset= 3600 actions= restart/5000/restart/30000/restart/120000"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Apply those actions when the service stops itself with an error code too (a start that
         gave up on a busy port, a server thread that ended), not only when the process crashes. -->
    <CustomAction Id="SetServiceFailureFlag"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]sc.exe&quot; failureflag BlueOnyxPrismService 1"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Required privileges: the SCM removes every privilege not listed from the service process
         (no SeImpersonate, SeAssignPrimaryToken, ...). Same as install_service.ps1, which explains
         the choice of this one. It takes effect at the next start, and StartServices comes after. -->
    <CustomAction Id="SetServicePrivileges"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]sc.exe&quot; privs BlueOnyxPrismService SeChangeNotifyPrivilege"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- The data folder's DACL: protected (nothing inherited from ProgramData, whose ACL lets Users
         create files in every folder below it), same result as install_service.ps1 for its install
         folder. Administrators and SYSTEM full control, LocalService modify, Users read (the tray,
         which runs as the logged-in user, reads the port from the config).

         icacls and not util:PermissionEx: that one merges into the ACL it finds, so the inherited
         Users write stays. SIDs, because account names are translated on a non-English Windows.
         No /T: children follow through inheritance, and a child with its own protected DACL
         (tools\hf, below) must keep it. [CommonAppDataFolder]BlueOnyxPrism and not [DATADIR]: a
         folder property ends in a backslash, which would escape the closing quote. Runs on every
         install, repair and upgrade, so an upgrade corrects the ACL of an older install.
         EnsureDataFolder: the folder is a Permanent component, and a failing icacls stops the
         install, so its existence is not left to how CreateFolders treats a folder that an
         uninstall with REMOVEDATA=1 deleted. An existing folder makes mkdir fail, which is
         ignored. -->
    <CustomAction Id="EnsureDataFolder"
                  Directory="CommonAppDataFolder"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c mkdir &quot;[CommonAppDataFolder]BlueOnyxPrism&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="ProtectDataFolder"
                  Directory="CommonAppDataFolder"
                  ExeCommand="&quot;[System64Folder]icacls.exe&quot; &quot;[CommonAppDataFolder]BlueOnyxPrism&quot; /inheritance:r /grant:r *S-1-5-32-544:(OI)(CI)F *S-1-5-18:(OI)(CI)F *S-1-5-19:(OI)(CI)M *S-1-5-32-545:(OI)(CI)RX /Q"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- A token saved by an older version sits in tools\hf with only the data folder's ACL, which
         Users can read. hf-login protects this folder on its next save (src/resources/hf_token.rs);
         this does it for a token that is already there. LocalService reads, as hf-login grants it.
         Return="ignore": the folder exists only after a login. -->
    <CustomAction Id="ProtectTokenFolder"
                  Directory="CommonAppDataFolder"
                  ExeCommand="&quot;[System64Folder]icacls.exe&quot; &quot;[CommonAppDataFolder]BlueOnyxPrism\tools\hf&quot; /inheritance:r /grant:r *S-1-5-32-544:(OI)(CI)F *S-1-5-18:(OI)(CI)F *S-1-5-19:(OI)(CI)RX /Q"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- An uninstall (not the removal of the old version during an upgrade) deletes the program
         folder with whatever the program created in it (e.g. a config or downloads of the console
         exe run from there) when it is the default folder. A folder the user picked may hold
         other files: there only the MSI's own files go. The data folder (config, downloaded
         runtimes and models, cache, logs, tools, and by default the dataset, reviewed labels and
         training runs, which no download brings back) stays, and a reinstall picks it up. Only
         exactly REMOVEDATA=1 deletes it, and KEEPDATA=1 wins over it: a bare REMOVEDATA would also be true for
         REMOVEDATA=0. Return="ignore": a file that cannot be deleted never blocks the uninstall. -->
    <SetProperty Id="BOP_DEFAULT_INSTALLFOLDER" Value="[ProgramFiles64Folder]Blue Onyx Prism\" After="CostFinalize" Sequence="execute" />
    <CustomAction Id="RemoveProgramFolder"
                  Directory="CommonAppDataFolder"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;[INSTALLFOLDER]&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveDataFolder"
                  Directory="CommonAppDataFolder"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;[CommonAppDataFolder]BlueOnyxPrism&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="EnsureDataFolder" After="CreateFolders" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="ProtectDataFolder" After="EnsureDataFolder" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="ProtectTokenFolder" After="ProtectDataFolder" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SetServiceFailureActions" After="InstallServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SetServiceFailureFlag" After="SetServiceFailureActions" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SetServicePrivileges" After="SetServiceFailureFlag" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveProgramFolder" After="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND INSTALLFOLDER ~= BOP_DEFAULT_INSTALLFOLDER" />
      <Custom Action="RemoveDataFolder" After="RemoveProgramFolder"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVEDATA=&quot;1&quot; AND NOT KEEPDATA" />
    </InstallExecuteSequence>

    <!-- Program files and the service -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="ServiceComponent" Bitness="always64">
        <File Id="ServiceExe" Source="$(var.BinDir)\blue-onyx-prism-service.exe" KeyPath="yes" />
        <ServiceInstall Id="BlueOnyxPrismServiceInstall"
                        Name="BlueOnyxPrismService"
                        DisplayName="Blue Onyx Prism"
                        Description="Blue Iris / CodeProject.AI compatible object detection (OpenVINO / ONNX Runtime)"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService"
                        Arguments="--config &quot;[DATADIR]blue_onyx_prism_config_service.json&quot;"
                        Vital="yes" />
        <ServiceControl Id="BlueOnyxPrismServiceControl"
                        Name="BlueOnyxPrismService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="no" />
        <!-- Wait="no": the service reports Running only once its port is bound and gives up after
             60 s when another program (CodeProject.AI, say) holds it; waiting would fail the
             install (error 1920). The failure flag above restarts it until the port is free. -->
        <util:EventSource Name="BlueOnyxPrism"
                          Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll"
                          SupportsErrors="yes" SupportsWarnings="yes" SupportsInformationals="yes" />
        <fire:FirewallException Id="BlueOnyxPrismFirewall"
                                Name="Blue Onyx Prism ([PORT])"
                                Protocol="tcp"
                                Port="[PORT]"
                                Scope="localSubnet"
                                Profile="[BOP_FIREWALL_PROFILES]" />
      </Component>

      <Component Id="CliComponent" Bitness="always64">
        <File Id="CliExe" Source="$(var.BinDir)\blue-onyx-prism.exe" KeyPath="yes" />
      </Component>
      <!-- Tray icon app (GUI subsystem); starts at login for every user through the Run key. -->
      <Component Id="TrayComponent" Bitness="always64">
        <File Id="TrayExe" Source="$(var.BinDir)\blue-onyx-prism-tray.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="BlueOnyxPrismTray" Type="string" Value="&quot;[INSTALLFOLDER]blue-onyx-prism-tray.exe&quot;" />
      </Component>
      <Component Id="BenchmarkComponent" Bitness="always64">
        <File Id="BenchmarkExe" Source="$(var.BinDir)\blue-onyx-prism-benchmark.exe" KeyPath="yes" />
      </Component>
      <!-- Visual C++ runtime, app-local (stage-vcruntime.ps1, from the pinned tool:vc-runtime wheel): Windows looks in the program
           folder before System32, so the exes and the OpenVINO / ONNX Runtime DLLs they load from
           the data folder run on a machine without the VC++ redistributable, or with an old one.
           One component per versioned file. -->
      <Component Id="VcRuntimeComponent" Bitness="always64">
        <File Id="VcRuntimeDll" Source="$(var.VcRuntimeDir)\vcruntime140.dll" KeyPath="yes" />
      </Component>
      <Component Id="VcRuntime1Component" Bitness="always64">
        <File Id="VcRuntime1Dll" Source="$(var.VcRuntimeDir)\vcruntime140_1.dll" KeyPath="yes" />
      </Component>
      <Component Id="MsvcpComponent" Bitness="always64">
        <File Id="MsvcpDll" Source="$(var.VcRuntimeDir)\msvcp140.dll" KeyPath="yes" />
      </Component>
      <Component Id="LicenseComponent" Bitness="always64">
        <File Id="LicenseFile" Source="$(var.RepoRoot)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyComponent" Bitness="always64">
        <File Id="ThirdPartyFile" Source="$(var.RepoRoot)\THIRD_PARTY_LICENSES.md" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeComponent" Bitness="always64">
        <File Id="ReadmeFile" Source="$(var.RepoRoot)\README.md" KeyPath="yes" />
      </Component>
      <!-- By-hand training where the service cannot train (capability::BY_HAND in src/training). -->
      <Component Id="TrainScriptComponent" Subdirectory="scripts" Bitness="always64">
        <File Id="TrainScriptFile" Source="$(var.RepoRoot)\scripts\train_model.py" KeyPath="yes" />
      </Component>
      <Component Id="ExportScriptComponent" Subdirectory="scripts" Bitness="always64">
        <File Id="ExportScriptFile" Source="$(var.RepoRoot)\scripts\export_model.py" KeyPath="yes" />
      </Component>
      <Component Id="AutolabelScriptComponent" Subdirectory="scripts" Bitness="always64">
        <File Id="AutolabelScriptFile" Source="$(var.RepoRoot)\scripts\autolabel.py" KeyPath="yes" />
      </Component>
      <Component Id="TrainRequirementsComponent" Subdirectory="scripts" Bitness="always64">
        <File Id="TrainRequirementsFile" Source="$(var.RepoRoot)\scripts\requirements-model-train.txt" KeyPath="yes" />
      </Component>

      <!-- Marks the service as owned by this MSI (see the launch condition above). -->
      <Component Id="InstallMarkerComponent" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\BlueOnyxPrism" Name="Installer" Type="string" Value="[ProductVersion]" KeyPath="yes" />
        <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\BlueOnyxPrism" Action="removeOnUninstall" />
      </Component>
    </ComponentGroup>

    <!-- Data folder (config, models, cache, logs, dataset, training runs): Permanent, so an
         upgrade and an uninstall keep it; only REMOVEDATA=1 deletes it (RemoveDataFolder above).
         ProtectDataFolder above sets its DACL on every install, a reinstall over a kept folder
         included; everything below inherits it. -->
    <ComponentGroup Id="DataFolder" Directory="DATADIR">
      <Component Id="DataDirComponent" Guid="2D8F6A14-5B7C-4E39-A0D1-93C4E7B15F68" Bitness="always64" Permanent="yes">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="StartMenuDir">
      <Component Id="StartMenuComponent" Bitness="always64">
        <Shortcut Id="TrayShortcut" Name="Blue Onyx Prism" Description="Blue Onyx Prism tray icon (start, stop, restart, open the web UI)" Target="[#TrayExe]" WorkingDirectory="INSTALLFOLDER" />
        <util:InternetShortcut Id="WebUiShortcut" Name="Blue Onyx Prism Web UI" Target="http://127.0.0.1:32168/" />
        <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\BlueOnyxPrism" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Blue Onyx Prism" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentGroupRef Id="DataFolder" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
