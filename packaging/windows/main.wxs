<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-machine MSI for Blue Onyx Prism (WiX Toolset v7, v4+ schema).
  Build with build-msi.ps1; preprocessor variables: Version, BinDir, RepoRoot, LicenseRtf.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Blue Onyx Prism"
           Manufacturer="Blue Onyx Prism"
           Version="$(var.Version)"
           UpgradeCode="6B1D7C52-3E0A-4F5B-9C6E-8A2F41D0B7E3"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Blue Onyx Prism is already installed. Uninstall it first if you really want to install an older version." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.RepoRoot)\assets\favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Public properties (msiexec /i blue-onyx-prism.msi PORT=32169). -->
    <Property Id="PORT" Value="32168" Secure="yes" />

    <!-- Block when the service was installed by scripts\install_service.ps1 (no MSI marker value),
         but never block an upgrade/repair/uninstall of this MSI. -->
    <Property Id="EXISTING_SERVICE_IMAGEPATH">
      <RegistrySearch Id="ExistingServiceSearch" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\BlueOnyxPrismService" Name="ImagePath" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="MSI_INSTALL_MARKER">
      <RegistrySearch Id="InstallMarkerSearch" Root="HKLM" Key="SOFTWARE\BlueOnyxPrism" Name="Installer" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR WIX_UPGRADE_DETECTED OR (NOT EXISTING_SERVICE_IMAGEPATH) OR MSI_INSTALL_MARKER"
            Message="Blue Onyx Prism is already installed as a service by scripts\install_service.ps1. Run scripts\uninstall_service.ps1 as administrator first, then run this installer again." />

    <!-- UI -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Directories -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Blue Onyx Prism" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="BlueOnyxPrism" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Blue Onyx Prism" />
    </StandardDirectory>

    <!-- Close a running tray before its exe is replaced or removed (upgrade, uninstall, repair):
         the tray has no window to ask, so it is terminated. -->
    <util:CloseApplication Id="CloseTray" Target="blue-onyx-prism-tray.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />

    <!-- Failure actions: restart after 5 s, 30 s, 120 s; reset the count after an hour. Same as
         install_service.ps1 (the built-in ServiceConfig has a single restart delay only). -->
    <CustomAction Id="SetServiceFailureActions"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]sc.exe&quot; failure BlueOnyxPrismService reset= 3600 actions= restart/5000/restart/30000/restart/120000"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="SetServiceFailureActions" After="InstallServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- Program files and the service -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="ServiceComponent" Bitness="always64">
        <File Id="ServiceExe" Source="$(var.BinDir)\blue-onyx-prism-service.exe" KeyPath="yes" />
        <ServiceInstall Id="BlueOnyxPrismServiceInstall"
                        Name="BlueOnyxPrismService"
                        DisplayName="Blue Onyx Prism"
                        Description="Blue Iris / CodeProject.AI compatible object detection (OpenVINO / ONNX Runtime)"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService"
                        Arguments="--config &quot;[DATADIR]blue_onyx_prism_config_service.json&quot;"
                        Vital="yes" />
        <ServiceControl Id="BlueOnyxPrismServiceControl"
                        Name="BlueOnyxPrismService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
        <util:EventSource Name="BlueOnyxPrism"
                          Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll"
                          SupportsErrors="yes" SupportsWarnings="yes" SupportsInformationals="yes" />
        <fire:FirewallException Id="BlueOnyxPrismFirewall"
                                Name="Blue Onyx Prism ([PORT])"
                                Protocol="tcp"
                                Port="[PORT]"
                                Scope="any"
                                Profile="all" />
      </Component>

      <Component Id="CliComponent" Bitness="always64">
        <File Id="CliExe" Source="$(var.BinDir)\blue-onyx-prism.exe" KeyPath="yes" />
      </Component>
      <!-- Tray icon app (GUI subsystem); starts at login for every user through the Run key. -->
      <Component Id="TrayComponent" Bitness="always64">
        <File Id="TrayExe" Source="$(var.BinDir)\blue-onyx-prism-tray.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="BlueOnyxPrismTray" Type="string" Value="&quot;[INSTALLFOLDER]blue-onyx-prism-tray.exe&quot;" />
      </Component>
      <Component Id="BenchmarkComponent" Bitness="always64">
        <File Id="BenchmarkExe" Source="$(var.BinDir)\blue-onyx-prism-benchmark.exe" KeyPath="yes" />
      </Component>
      <Component Id="LicenseComponent" Bitness="always64">
        <File Id="LicenseFile" Source="$(var.RepoRoot)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyComponent" Bitness="always64">
        <File Id="ThirdPartyFile" Source="$(var.RepoRoot)\THIRD_PARTY_LICENSES.md" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeComponent" Bitness="always64">
        <File Id="ReadmeFile" Source="$(var.RepoRoot)\README.md" KeyPath="yes" />
      </Component>

      <!-- Marks the service as owned by this MSI (see the launch condition above). -->
      <Component Id="InstallMarkerComponent" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\BlueOnyxPrism" Name="Installer" Type="string" Value="[ProductVersion]" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Data folder: kept on uninstall (config, models, cache, logs). LocalService gets Modify,
         Administrators and SYSTEM full control; everything below inherits it. -->
    <ComponentGroup Id="DataFolder" Directory="DATADIR">
      <Component Id="DataDirComponent" Guid="2D8F6A14-5B7C-4E39-A0D1-93C4E7B15F68" Bitness="always64" Permanent="yes">
        <CreateFolder>
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="LocalSystem" GenericAll="yes" />
          <util:PermissionEx User="LocalService" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" Delete="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="StartMenuDir">
      <Component Id="StartMenuComponent" Bitness="always64">
        <Shortcut Id="TrayShortcut" Name="Blue Onyx Prism" Description="Blue Onyx Prism tray icon (start, stop, restart, open the web UI)" Target="[#TrayExe]" WorkingDirectory="INSTALLFOLDER" />
        <util:InternetShortcut Id="WebUiShortcut" Name="Blue Onyx Prism Web UI" Target="http://127.0.0.1:32168/" />
        <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\BlueOnyxPrism" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Blue Onyx Prism" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentGroupRef Id="DataFolder" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
