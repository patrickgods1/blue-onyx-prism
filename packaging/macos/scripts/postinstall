#!/bin/bash
# Installer postinstall (runs as root). $2 = install location, $3 = target volume.
# Mirrors scripts/install_launchd.sh for the runtime-less pkg: the service downloads OpenVINO /
# ONNX Runtime itself on first start into download_dir. An existing config is never overwritten,
# and an uninstall that kept the data leaves this data root for the install to pick up.
set -euo pipefail

TARGET="${3:-/}"
if [ "$TARGET" != "/" ]; then
  echo "Blue Onyx Prism can only be installed on the startup disk (target '$TARGET' selected)." >&2
  exit 1
fi

INSTALL_DIR=/usr/local/blue-onyx-prism
COMMON="$INSTALL_DIR/scripts/launchd_common.sh"
if [ ! -f "$COMMON" ]; then
  echo "Package payload is incomplete: $COMMON is missing." >&2
  exit 1
fi
# shellcheck source=scripts/launchd_common.sh
. "$COMMON"

bop_create_account
# Kept data of an earlier _blueonyx with another id, anywhere in the tree. Before
# bop_create_dirs, which corrects the top folders only and would hide a mismatch there.
bop_own_kept_dirs
bop_create_dirs
bop_install_newsyslog
bop_seed_config
bop_install_plist "$PLIST_DST"
bop_bootstrap
# The menu bar app for the logged-in user (never fails the install).
bop_tray_start
exit 0
